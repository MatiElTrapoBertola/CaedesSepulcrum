  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Salvador: Reduce el da\xF1o recibido en 5% por punto.\r\n\r\nSin remordimiento:
    Aumenta el da\xF1o producido en 5% por punto.\n\nCon los \xE1ngeles: Aumenta
    la velocidad de movimiento en 2,5% por punto.\n\nAl que madruga\u2026: Aumenta
    en 6% por punto la cantidad de materiales obtenidos.\n\nGracia de Dios: Aumenta
    la regeneraci\xF3n de salud en 0,1 hp por segundo por punto.\r\n\r\nElixir de
    los \xE1ngeles: Aumenta en 5 HP por punto la cantidad de salud recuperada mediante
    las pociones.\r\n\r\nQue sigan viniendo: Despu\xE9s de derrotar una cantidad
    determinada de enemigos, el jugador recupera 10 HP."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
